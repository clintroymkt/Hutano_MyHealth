<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Wellness">

    <View
        android:id="@+id/wellness_bg"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:background="@drawable/ic_wellness_bg"
        android:elevation="1dp"
        android:scaleX="1.12"
        android:scaleY="1.2"
        android:outlineProvider="bounds" />

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/userImage"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_centerHorizontal="true"
        android:src="@drawable/wellnessbg"
        android:elevation="2dp"
        app:civ_border_color="#FFFFFFFF"
        app:civ_border_width="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/wellness_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/wellness_bg" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="250dp"

        >




        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"

            android:background="@color/colorWhite"
            >

            <TextView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:paddingTop="20dp"
                android:layout_gravity="center_horizontal"
                android:gravity="center"
                android:fontFamily="@font/nunito"
                android:text="\n Explore your health and wellness below"
                android:textColor="@color/black"
                android:textSize="25sp" />


            <RelativeLayout
                android:id="@+id/wellnesscard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/dashboard_card"
                android:elevation="8dp">

                <LinearLayout
                    android:id="@+id/wellnesslayout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:weightSum="100">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20sp"
                        android:layout_weight="40"
                        android:paddingStart="20sp"
                        android:text="8 Dimensions of Wellness"
                        android:textColor="@color/logoColorBlack"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">



                        <RelativeLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            >

                            <ImageView
                                android:id="@+id/wellnessimg"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/wellnessm"/>

                            <TextView
                                android:id="@+id/wellnessdesc"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/nunito_bold"
                                android:layout_below="@+id/txtCalUnit"
                                android:layout_marginLeft="100dp"
                                android:layout_marginTop="20dp"

                                android:text="Explore the 8 dimensions of Wellness"
                                android:textColor="@color/logoColorBlack"
                                android:textSize="12sp" />



                        </RelativeLayout>


                    </RelativeLayout>


                </LinearLayout>


            </RelativeLayout>


            <RelativeLayout
                android:id="@+id/devicescard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/dashboard_card"
                android:elevation="8dp"
                android:layout_marginBottom="40dp">

                <LinearLayout
                    android:id="@+id/devicelayout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:weightSum="100">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20sp"
                        android:layout_weight="40"
                        android:paddingStart="20sp"
                        android:text="Devices"
                        android:textColor="@color/logoColorBlack"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">



                        <RelativeLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            >

                            <ImageView
                                android:id="@+id/devicesimg"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/devicesm"/>

                            <TextView
                                android:id="@+id/calories"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/nunito_bold"
                                android:layout_below="@+id/txtCalUnit"
                                android:layout_marginLeft="100dp"
                                android:layout_marginTop="20dp"

                                android:text="Connect to all MyHealth smart devices"
                                android:textColor="@color/logoColorBlack"
                                android:textSize="12sp" />



                        </RelativeLayout>


                    </RelativeLayout>


                </LinearLayout>


            </RelativeLayout>








        </LinearLayout>
    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>