                                android:text="Connect to all MyHealth smart devices"
                                android:textColor="@color/logoColorBlack"
                                android:textSize="12sp" />



                        </RelativeLayout>


                    </RelativeLayout>


                </LinearLayout>


            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/socialcard"
                android:layout_width="wrap_content"
                android:layout_height="150dp"
                android:layout_marginStart="15dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="15dp"
                android:background="@drawable/bg_socwellness"
                android:elevation="8dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:id="@+id/sociallayout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:weightSum="100">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20sp"
                        android:layout_weight="40"
                        android:paddingStart="20sp"
                        android:text="Social Wellness"
                        android:textColor="@color/logoColorWhite"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">



                        <RelativeLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            >

                            <ImageView
                                android:id="@+id/devicesimg"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/devicesm"/>

                            <TextView
                                android:id="@+id/calories"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/nunito_bold"
                                android:layout_below="@+id/txtCalUnit"
                                android:layout_marginLeft="100dp"
                                android:layout_marginTop="20dp"

                                android:text="Connect to all MyHealth smart devices"
                                android:textColor="@color/logoColorBlack"
                                android:textSize="12sp" />



                        </RelativeLayout>


                    </RelativeLayout>


                </LinearLayout>


            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/occupationalcard"
                android:layout_width="wrap_content"
                android:layout_height="150dp"
                android:layout_marginStart="15dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="15dp"
                android:background="@drawable/bg_occuwellness"
                android:elevation="8dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:id="@+id/occupationallayout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:weightSum="100">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20sp"
                        android:layout_weight="40"
                        android:paddingStart="20sp"
                        android:text="Occupational Wellness"
                        android:textColor="@color/logoColorWhite"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">



                        <RelativeLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            >

                            <ImageView
                                android:id="@+id/devicesimg"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/devicesm"/>

                            <TextView
                                android:id="@+id/calories"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/nunito_bold"
                                android:layout_below="@+id/txtCalUnit"
                                android:layout_marginLeft="100dp"
                                android:layout_marginTop="20dp"

                                android:text="Connect to all MyHealth smart devices"
                                android:textColor="@color/logoColorBlack"
                                android:textSize="12sp" />



                        </RelativeLayout>


                    </RelativeLayout>


                </LinearLayout>


            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/emotionalcard"
                android:layout_width="wrap_content"
                android:layout_height="150dp"
                android:layout_marginStart="15dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="15dp"
                android:background="@drawable/bg_emowellness"
                android:elevation="8dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:id="@+id/emotionallayout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:weightSum="100">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20sp"
                        android:layout_weight="40"
                        android:paddingStart="20sp"
