                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/nunito_bold"
                                android:layout_below="@+id/txtCalUnit"
                                android:layout_marginLeft="100dp"
                                android:layout_marginTop="20dp"

                                android:text="Connect to all MyHealth smart devices"
                                android:textColor="@color/logoColorBlack"
                                android:textSize="12sp" />



                        </RelativeLayout>


                    </RelativeLayout>


                </LinearLayout>


            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/financialcard"
                android:layout_width="wrap_content"
                android:layout_height="150dp"
                android:layout_marginStart="15dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="15dp"
                android:background="@drawable/bg_finwellness"
                android:elevation="8dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:id="@+id/financiallayout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:weightSum="100">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20sp"
                        android:layout_weight="40"
                        android:paddingStart="20sp"
                        android:text="Financial Wellness"
                        android:textColor="@color/logoColorWhite"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">



                        <RelativeLayout
